{
  "name": "PharmaFlow AI",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"]
    }
  },
  "postCreateCommand": "pip install --user -r requirements.txt jupyterlab",
  "postStartCommand": "nohup jupyter lab --no-browser --port=8888 --NotebookApp.token='' --NotebookApp.password='' > /tmp/jupyterlab.log 2>&1 &",
  "portsAttributes": {
    "8888": {
      "label": "JupyterLab",
      "onAutoForward": "notify"
    }
  }
}
